RewriteEngine On

# Alle Varianten direkt zu https://eichhof.me
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.eichhof\.me$ [NC]
RewriteRule ^(.*)$ https://eichhof.me/$1 [L,R=301]

# ============================================================================
# MULTILINGUAL URL ROUTING
# ============================================================================

# Legacy ?lang= Query-Strings auf saubere URLs umleiten (301)
# Nur bei direkten Requests, nicht bei internen Rewrites
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^lang=da$ [NC]
RewriteRule ^(index\.php)?$ /dk/? [L,R=301]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^lang=en$ [NC]
RewriteRule ^(index\.php)?$ /en/? [L,R=301]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^lang=de$ [NC]
RewriteRule ^(index\.php)?$ /? [L,R=301]

# /about/ direkt → saubere URL (301)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^about/(index\.php)?$ /ueber [L,R=301]

# Language paths: /en/ and /dk/ → index.php with lang parameter
RewriteRule ^en/?$ index.php?lang=en [L,QSA]
RewriteRule ^dk/?$ index.php?lang=da [L,QSA]

# German subpages (no language prefix)
RewriteRule ^impressum/?$ index.php?lang=de&overlay=impressum [L,QSA]
RewriteRule ^datenverarbeitung/?$ index.php?lang=de&overlay=privacy [L,QSA]
RewriteRule ^kontakt/?$ index.php?lang=de&overlay=kontakt [L,QSA]
RewriteRule ^ueber/?$ about/index.php?lang=de [L,QSA]

# English subpages (/en/...)
RewriteRule ^en/legal-notice/?$ index.php?lang=en&overlay=legal [L,QSA]
RewriteRule ^en/privacy/?$ index.php?lang=en&overlay=privacy [L,QSA]
RewriteRule ^en/contact/?$ index.php?lang=en&overlay=contact [L,QSA]
RewriteRule ^en/about/?$ about/index.php?lang=en [L,QSA]

# Danish subpages (/dk/...)
RewriteRule ^dk/kolofon/?$ index.php?lang=da&overlay=kolofon [L,QSA]
RewriteRule ^dk/privatlivspolitik/?$ index.php?lang=da&overlay=privacy [L,QSA]
RewriteRule ^dk/kontakt/?$ index.php?lang=da&overlay=kontakt [L,QSA]
RewriteRule ^dk/om/?$ about/index.php?lang=da [L,QSA]

# Default: serve index.php (German, with browser detection fallback)
DirectoryIndex index.php index.html

# ============================================================================
# SECURITY
# ============================================================================

# Schutz sensibler Dateien und Verzeichnisse

# 1. Alle Dotfiles blockieren (.webhook-secret, .contact-config.json,
#    .contact-ratelimit.json, .apiflash-key, .deploy-log.txt, .env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 2. Sensible/interne Dateiendungen blockieren
#    - md: Doku wie DEPLOY-SETUP.md, README.md gehört nicht ins Web
#    - json/yml/yaml/lock: Config- und Lockfiles
#    - env/log/bak/sql/ini/sh: klassische Leak-Kandidaten
#    - php: standardmässig alles dicht; Entrypoints werden unten explizit freigegeben
<FilesMatch "\.(env|log|bak|sql|ini|sh|php|md|json|yml|yaml|lock)$">
    Require all denied
</FilesMatch>

# 3. Belt-and-suspenders: explizite Sperre für bekannte Secret-/State-Dateien.
#    Redundant zu (1), macht aber Intent dokumentiert und schützt, falls ein
#    zukünftiger Edit die Dotfile-Regel versehentlich aufweicht.
<FilesMatch "^(\.webhook-secret|\.apiflash-key|\.contact-.*\.json|\.deploy-log\.txt)$">
    Require all denied
</FilesMatch>

# Ausnahmen: öffentliche PHP-Entrypoints
<Files "index.php">
    Require all granted
</Files>
<Files "deploy.php">
    Require all granted
</Files>
<Files "update-previews.php">
    Require all granted
</Files>
<Files "contact.php">
    Require all granted
</Files>
RedirectMatch 404 /\.git

# Content-Type für Sitemaps
<Files "sitemap.xml">
    Header set Content-Type "application/xml"
</Files>
<Files "sitemap-images.xml">
    Header set Content-Type "application/xml"
</Files>

# ETags deaktivieren (unnötig bei statischen Seiten mit Cache-Control)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "no-referrer"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-MCyEvVOO67rI0IwZN9PCA4aINLRDAhxFdM6P0A8p6R4='; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "unsafe-none"
    Header set Cross-Origin-Resource-Policy "same-origin"
</IfModule>
# Bilder für externe Embeds freigeben (OG-Image, Social-Media-Previews)
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
        Header set Cross-Origin-Resource-Policy "cross-origin"
    </FilesMatch>
</IfModule>

# GZIP Kompression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    # Note: WOFF/WOFF2 fonts are already compressed, DEFLATE has minimal effect
    # Removed font compression rules as site uses system font stack
</IfModule>

# Expires Headers für Browser-Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # Note: Font rules removed - site uses system font stack
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType application/ld+json "access plus 1 month"
</IfModule>

# Cache-Control Header
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    # Note: Font rules removed - site uses system font stack
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Optional: Hotlinking-Schutz für Bilder (auskommentiert)
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https://(www\.)?eichhof\.me [NC]
# RewriteCond %{HTTP_REFERER} !^https://(www\.)?google\. [NC]
# RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F,NC]