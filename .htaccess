RewriteEngine On

# Alle Varianten direkt zu https://eichhof.me
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.eichhof\.me$ [NC]
RewriteRule ^(.*)$ https://eichhof.me/$1 [L,R=301]

# ============================================================================
# MULTILINGUAL URL ROUTING
# ============================================================================

# Hinweis: Die bare-Root-"/"-Logik (reiner Accept-Language-Router mit Bot-
# 301 auf /de/, Human-302 auf /de/|/en/|/da/) lebt in index.php. Apache
# routet hier nur die expliziten Sprachpfade auf den passenden index.php-
# Aufruf.

# Legacy 301: /dk/* → /da/* (permanent). Das Sprachpräfix folgt jetzt
# ISO 639-1 (da = Dänisch als Sprache), nicht dem Country-Code dk.
# Muss VOR den /da/-Rewrites stehen, damit die 301-Umleitung greift,
# bevor irgendein anderer Rule den Request frisst. Bare /dk → /da/;
# Unterpfade /dk/foo → /da/foo.
RewriteRule ^dk/?$ /da/ [L,R=301]
RewriteRule ^dk/(.+)$ /da/$1 [L,R=301]

# Legacy 301: DE-Subpages ohne Language-Prefix → mit /de/. Das gesamte
# DE-URL-Scheme folgt jetzt symmetrisch dem Language-Prefix (wie EN/DA).
# Muss VOR den neuen /de/-Rewrites stehen, damit die 301-Umleitung greift.
RewriteRule ^ueber/?$ /de/ueber [L,R=301]
RewriteRule ^impressum/?$ /de/impressum [L,R=301]
RewriteRule ^datenverarbeitung/?$ /de/datenverarbeitung [L,R=301]
RewriteRule ^kontakt/?$ /de/kontakt [L,R=301]

# /about/ direkt → saubere DE-URL (301)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^about/(index\.php)?$ /de/ueber [L,R=301]

# Trailing-Slash-Kanonisierung: vermeidet, dass Google /de und /de/ als
# zwei separate URLs indexiert (Duplicate-Content-Symptom in GSC).
#  - Sprach-Roots /de, /en, /da → /de/, /en/, /da/ (mit Slash, da
#    Verzeichnis-artig)
#  - Sprach-Subpages /de/ueber/, /en/about/, /da/om/ → ohne Slash
#    (passend zu unseren <link rel="canonical">-Tags)
RewriteRule ^(de|en|da)$ /$1/ [L,R=301]
RewriteRule ^(de|en|da)/(.+)/$ /$1/$2 [L,R=301]

# Language paths: /de/, /en/, /da/ → index.php with lang parameter
RewriteRule ^de/?$ index.php?lang=de [L,QSA]
RewriteRule ^en/?$ index.php?lang=en [L,QSA]
RewriteRule ^da/?$ index.php?lang=da [L,QSA]

# German subpages (/de/...)
RewriteRule ^de/impressum/?$ index.php?lang=de&overlay=impressum [L,QSA]
RewriteRule ^de/datenverarbeitung/?$ index.php?lang=de&overlay=privacy [L,QSA]
RewriteRule ^de/kontakt/?$ index.php?lang=de&overlay=kontakt [L,QSA]
RewriteRule ^de/ueber/?$ about/index.php?lang=de [L,QSA]

# English subpages (/en/...)
RewriteRule ^en/legal-notice/?$ index.php?lang=en&overlay=legal [L,QSA]
RewriteRule ^en/privacy/?$ index.php?lang=en&overlay=privacy [L,QSA]
RewriteRule ^en/contact/?$ index.php?lang=en&overlay=contact [L,QSA]
RewriteRule ^en/about/?$ about/index.php?lang=en [L,QSA]

# Danish subpages (/da/...)
RewriteRule ^da/kolofon/?$ index.php?lang=da&overlay=kolofon [L,QSA]
RewriteRule ^da/privatlivspolitik/?$ index.php?lang=da&overlay=privacy [L,QSA]
RewriteRule ^da/kontakt/?$ index.php?lang=da&overlay=kontakt [L,QSA]
RewriteRule ^da/om/?$ about/index.php?lang=da [L,QSA]

# Default: serve index.php (German, with browser detection fallback)
DirectoryIndex index.php index.html

# Eigene 404-Seite statt Apache-Default. 404.php leitet die Sprache aus
# dem Präfix der angefragten URL ab (/en/* → EN, /da/* → DA, sonst DE).
ErrorDocument 404 /404.php

# ============================================================================
# SECURITY
# ============================================================================

# Schutz sensibler Dateien und Verzeichnisse

# 1. Alle Dotfiles blockieren (.webhook-secret, .contact-config.json,
#    .contact-ratelimit.json, .apiflash-key, .deploy-log.txt, .env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 2. Sensible/interne Dateiendungen blockieren
#    - md: Doku wie DEPLOY-SETUP.md, README.md gehört nicht ins Web
#    - json/yml/yaml/lock: Config- und Lockfiles
#    - env/log/bak/sql/ini/sh: klassische Leak-Kandidaten
#    - php: standardmässig alles dicht; Entrypoints werden unten explizit freigegeben
<FilesMatch "\.(env|log|bak|sql|ini|sh|php|md|json|yml|yaml|lock)$">
    Require all denied
</FilesMatch>

# 3. Belt-and-suspenders: explizite Sperre für bekannte Secret-/State-Dateien.
#    Redundant zu (1), macht aber Intent dokumentiert und schützt, falls ein
#    zukünftiger Edit die Dotfile-Regel versehentlich aufweicht.
<FilesMatch "^(\.webhook-secret|\.apiflash-key|\.contact-.*\.json|\.deploy-log\.txt)$">
    Require all denied
</FilesMatch>

# Ausnahmen: öffentliche PHP-Entrypoints
<Files "index.php">
    Require all granted
</Files>
<Files "deploy.php">
    Require all granted
</Files>
<Files "contact.php">
    Require all granted
</Files>
# update-previews.php über HTTP erreichbar (Cron ruft die URL mit ?token=…
# auf), aber im Script selbst durch einen Secret-Token geschützt: ohne
# gültigen Token antwortet es mit 403, bevor ein API-Call passiert. Der
# Token liegt in .preview-cron-token (Dotfile → oben web-gesperrt).
<Files "update-previews.php">
    Require all granted
</Files>
<Files "404.php">
    Require all granted
</Files>
RedirectMatch 404 /\.git

# Server-generiertes Screenshot-Log nicht über das Web ausliefern
# (.htaccess blockt zwar *.log, die Datei endet aber auf .txt).
<Files "update-log.txt">
    Require all denied
</Files>

# Content-Type für Sitemaps
<Files "sitemap.xml">
    Header set Content-Type "application/xml"
</Files>
<Files "sitemap-images.xml">
    Header set Content-Type "application/xml"
</Files>

# ETags deaktivieren (unnötig bei statischen Seiten mit Cache-Control)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "no-referrer"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-MCyEvVOO67rI0IwZN9PCA4aINLRDAhxFdM6P0A8p6R4='; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "unsafe-none"
    Header set Cross-Origin-Resource-Policy "same-origin"
</IfModule>
# Bilder für externe Embeds freigeben (OG-Image, Social-Media-Previews)
<IfModule mod_headers.c>
    <FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|svg|ico)$">
        Header set Cross-Origin-Resource-Policy "cross-origin"
    </FilesMatch>
</IfModule>

# GZIP Kompression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    # Note: WOFF/WOFF2 fonts are already compressed, DEFLATE has minimal effect
    # Removed font compression rules as site uses system font stack
</IfModule>

# Expires Headers für Browser-Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # Note: Font rules removed - site uses system font stack
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType application/ld+json "access plus 1 month"
</IfModule>

# Cache-Control Header
<IfModule mod_headers.c>
    <FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    # Note: Font rules removed - site uses system font stack
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Optional: Hotlinking-Schutz für Bilder (auskommentiert)
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https://(www\.)?eichhof\.me [NC]
# RewriteCond %{HTTP_REFERER} !^https://(www\.)?google\. [NC]
# RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F,NC]