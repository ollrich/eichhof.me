RewriteEngine On

# Alle Varianten direkt zu https://eichhof.me
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.eichhof\.me$ [NC]
RewriteRule ^(.*)$ https://eichhof.me/$1 [L,R=301]

# Schutz sensibler Dateien und Verzeichnisse
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|log|bak|sql|ini|sh|php)$">
    Require all denied
</FilesMatch>
# Ausnahmen für PHP-Scripts
<Files "deploy.php">
    Require all granted
</Files>
<Files "update-previews.php">
    Require all granted
</Files>
RedirectMatch 404 /\.git

# Content-Type für Sitemaps
<Files "sitemap.xml">
    Header set Content-Type "application/xml"
</Files>
<Files "sitemap-images.xml">
    Header set Content-Type "application/xml"
</Files>

# LLM-Dateien: CORS-Header für Cross-Origin-Zugriff durch KI-Bots
# Diese überschreiben die globale CORP "same-origin" Policy (Zeile 69),
# damit LLM-Crawler die Dateien von anderen Domains abrufen können.
<Files "llms.txt">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cross-Origin-Resource-Policy "cross-origin"
    Header set Access-Control-Allow-Origin "*"
</Files>
<Files "llms.html">
    Header set Content-Type "text/html; charset=utf-8"
    Header set Cross-Origin-Resource-Policy "cross-origin"
    Header set Access-Control-Allow-Origin "*"
</Files>
<Files "llms.md">
    Header set Content-Type "text/markdown; charset=utf-8"
    Header set Cross-Origin-Resource-Policy "cross-origin"
    Header set Access-Control-Allow-Origin "*"
</Files>

# ETags deaktivieren (unnötig bei statischen Seiten mit Cache-Control)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; upgrade-insecure-requests"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "unsafe-none"
    Header set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# GZIP Kompression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    # Note: WOFF/WOFF2 fonts are already compressed, DEFLATE has minimal effect
    # Removed font compression rules as site uses system font stack
</IfModule>

# Expires Headers für Browser-Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # Note: Font rules removed - site uses system font stack
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType application/ld+json "access plus 1 month"
</IfModule>

# Cache-Control Header
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    # Note: Font rules removed - site uses system font stack
    <FilesMatch "\.(html)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Optional: Hotlinking-Schutz für Bilder (auskommentiert)
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https://(www\.)?eichhof\.me [NC]
# RewriteCond %{HTTP_REFERER} !^https://(www\.)?google\. [NC]
# RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F,NC]